# ─────────────────────────────────────────────────────────────────
# OrgAudi · Frontend env template
# Copie para .env.local e preencha. .env.local NÃO é commitado.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (opcional) ─────────────────────────────────────────
# Sem essas variáveis, o sistema opera só em memória (sem persistência).
# Para ativar, crie um projeto em https://supabase.com/dashboard
# e rode a migration em supabase/migrations/0001_orgaudi_init.sql
# (via SQL Editor no painel do Supabase).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Backend API (default: http://localhost:8000) ───────────────
# VITE_API_BASE=http://localhost:8000
